# Imported from /etc/nixos/configuration.nix by `sbx new --image nixos`.
# The agent may edit this (or configuration.nix) and run `sudo nixos-rebuild switch`;
# roll back with `sudo nixos-rebuild switch --rollback` or `sbx restore <name>`.
{ pkgs, ... }:
{
  imports = [ ./sbx-agents.nix ]; # generated by sbx: the sandbox's coding agents
  nixpkgs.config.allowUnfree = true; # e.g. claude-code is unfree
  nix.settings.experimental-features = [ "nix-command" "flakes" ];

  # Egress only via the host's allowlisting proxy (also applied to nix-daemon).
  networking.proxy.default = "@SBX_PROXY_URL@";
  networking.proxy.noProxy = "@SBX_NO_PROXY@";

  virtualisation.docker.enable = true;
  virtualisation.docker.daemon.settings.proxies = {
    "http-proxy" = "@SBX_PROXY_URL@";
    "https-proxy" = "@SBX_PROXY_URL@";
    "no-proxy" = "@SBX_NO_PROXY@";
  };

  users.users.@SBX_GUEST_USER@ = {
    isNormalUser = true;
    uid = @SBX_UID@;
    extraGroups = [ "wheel" "docker" ];
  };
  security.sudo.wheelNeedsPassword = false;

  environment.systemPackages = with pkgs; [
    git curl jq unzip
    iproute2 iptables iputils dnsutils tcpdump netcat-openbsd
    docker-compose
  ];
}
