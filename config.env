# abox settings. These are the built-in defaults; `sudo abox host install`
# copies them to /etc/abox/config.env, which takes precedence. After editing
# that file run: sudo abox host apply

# Incus bridge that all sandboxes attach to (IPv4 only, NAT'd, /24).
ABOX_BRIDGE=aboxbr0
ABOX_NET_PREFIX=10.88.0            # bridge gets .1, guests get DHCP leases from it

# Egress proxy (squid) listening on the host, reachable from guests at ${ABOX_NET_PREFIX}.1
ABOX_PROXY_PORT=3128

# Incus storage pool (btrfs loop file => cheap snapshots)
ABOX_POOL=abox
ABOX_POOL_SIZE=150GiB

# Images
ABOX_UBUNTU_IMAGE=images:ubuntu/24.04/cloud
ABOX_NIXOS_IMAGE=images:nixos/unstable

# User inside every sandbox (uid = your host uid, so /work files keep your ownership)
ABOX_GUEST_USER=agent

# Coding agents (see agents/). Default set installed into new sandboxes:
ABOX_DEFAULT_AGENTS="claude"
# Agents whose egress domains are added to the global allowlist (empty = all built-in agents)
ABOX_AGENTS_ENABLED=""

# Default open-egress window for `abox net open` (minutes)
ABOX_NET_OPEN_MINUTES=30
