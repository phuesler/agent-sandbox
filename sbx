#!/bin/bash
# sbx - sandboxes for coding agents (Claude Code, Codex, opencode, ...) on Incus.
set -euo pipefail
SBX_UID=$(id -u)
source "$(dirname "$(readlink -f "$0")")/lib/common.sh"

GUEST_PATH=/run/wrappers/bin:/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
GUSER=$SBX_GUEST_USER

usage() {
  cat <<EOF
usage: sbx <command> [args]

Lifecycle
  init                               load/refresh Incus profiles from ./profiles
  new <name> --path <dir> [opts]     create a sandbox; only <dir> is shared (at /work)
        --container (default) | --vm
        --image ubuntu (default) | nixos
        --agent NAME[,NAME]          coding agents to install (repeatable; default: ${SBX_DEFAULT_AGENTS})
        --secret KEY=FILE            export KEY (value read from host FILE) in the sandbox (repeatable)
        --cpus N  --memory 8GiB  --disk 60GiB
  ls                                 list sandboxes
  start|stop <name>
  wait <name>                        wait until the sandbox is up and its network works
  rm <name> [-f]                     delete sandbox (project dir on host is untouched)

Agents (definitions in agents/<name>/)
  agents                             list available agents
  agent-install <name> <agent...> [--update]   install (or update) agents in a sandbox
  run <name> <agent> [args]          run an agent in autonomous mode in /work
  claude <name> [args]               shorthand for: run <name> claude

Use
  shell <name>                       login shell as '${GUSER}' in /work
  root <name>                        root shell
  exec <name> -- <cmd...>            run a command as '${GUSER}' in /work

Secrets (env vars exported in the sandbox's login shells; values never in Incus config)
  secret set <name> KEY FILE | secret rm <name> KEY | secret ls <name>

Snapshots
  snap <name> [label]                snapshot (default label: timestamp)
  snaps <name>                       list snapshots
  restore <name> [label]             restore (default: 'clean' = freshly provisioned)

Egress (allowlist proxy; edit egress/allowlist.txt or agents/*/allowlist.txt, then sudo egress/apply.sh)
  net open <name> [minutes]          unrestricted internet for this sandbox (default ${SBX_NET_OPEN_MINUTES}m)
  net close <name>
  net status
  net log [lines]                    recently blocked destinations (to extend the allowlist)
EOF
}

valid_name() { [[ $1 =~ ^[a-z][a-z0-9-]{0,61}[a-z0-9]$ ]] || die "invalid name '$1' (lowercase letters, digits, dashes)"; }
valid_key()  { [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid variable name '$1'"; }
exists()     { incus info "$1" >/dev/null 2>&1; }
need()       { [[ -n ${1:-} ]] || { usage; exit 2; }; exists "$1" || die "no such sandbox: $1"; }
is_sbx()     { [[ $(incus config get "$1" user.sbx 2>/dev/null) == true ]] || die "$1 is not an sbx sandbox"; }

inst_ip() {
  local re="${SBX_NET_PREFIX//./\\.}\\.[0-9]+"
  incus list "^$1\$" -c4 -f csv | grep -oE "$re" | head -1
}

# Wait until incus exec works and the guest can reach the egress proxy
# (after start/restore the network comes up a few seconds after the agent).
wait_ready() {
  local i
  for i in $(seq 1 120); do
    incus exec "$1" -- /bin/sh -c true >/dev/null 2>&1 && break
    [[ $i -lt 120 ]] || die "$1 did not become reachable via incus exec"
    sleep 2
  done
  for i in $(seq 1 60); do
    incus exec "$1" --env "PATH=$GUEST_PATH" -- bash -c "exec 3<>/dev/tcp/$SBX_HOST_IP/$SBX_PROXY_PORT" >/dev/null 2>&1 && return 0
    sleep 1
  done
  die "$1 cannot reach the egress proxy at $SBX_PROXY_URL (is sbx-proxy running?)"
}

# ---------------------------------------------------------------- comma lists in instance config
get_list() { incus config get "$1" "$2" 2>/dev/null | tr ',' ' ' | xargs; }
set_list() { local name=$1 key=$2; shift 2; incus config set "$name" "$key=$(echo "$*" | xargs | tr ' ' ',')"; }
list_add() {
  local name=$1 key=$2 cur x; shift 2; cur=" $(get_list "$name" "$key") "
  for x; do [[ $cur == *" $x "* ]] || cur+="$x "; done
  set_list "$name" "$key" $cur
}
list_del() {
  local name=$1 key=$2 x out=(); shift 2
  for x in $(get_list "$name" "$key"); do [[ " $* " == *" $x "* ]] || out+=("$x"); done
  set_list "$name" "$key" "${out[@]}"
}

# ---------------------------------------------------------------- agents
list_agents() {
  local d
  for d in "$SBX_ROOT"/agents/*/; do
    [[ -f $d/agent.conf && -f $d/install.sh ]] && basename "$d"
  done
}
valid_agent() {
  [[ $1 =~ ^[a-z][a-z0-9-]*$ && -f $SBX_ROOT/agents/$1/agent.conf && -f $SBX_ROOT/agents/$1/install.sh ]] \
    || die "unknown agent '$1' (available: $(list_agents | xargs))"
}
# agent_var <agent> <VAR>: value of VAR from agents/<agent>/agent.conf
agent_var() {
  ( AGENT_DESC="" AGENT_CMD="" AGENT_NIXPKG="" AGENT_AUTH=""
    # shellcheck source=/dev/null
    source "$SBX_ROOT/agents/$1/agent.conf"; printf '%s' "${!2:-}" )
}

# Run a command string as the guest user (login shell => proxy env; ~/.local/bin on PATH;
# ~/.sbx-env secrets loaded). SBX_CWD (optional) selects a directory below /work.
as_user() {
  local name=$1 cmd=$2 cwd=/work
  if [[ -n ${SBX_CWD:-} ]]; then
    [[ $SBX_CWD =~ ^/work(/[A-Za-z0-9._@+,=-]+)*/?$ && $SBX_CWD != *"/.."* ]] \
      && cwd=$SBX_CWD || warn "ignoring SBX_CWD='$SBX_CWD' (must be a plain path below /work)"
  fi
  local tty=(); [[ -t 0 && -t 1 ]] && tty=(-t) || tty=(-T)
  incus exec "${tty[@]}" "$name" --env "PATH=$GUEST_PATH" -- \
    su -l "$GUSER" -c "export PATH=\"\$HOME/.local/bin:\$PATH\"; cd $(printf '%q' "$cwd") 2>/dev/null || cd /work 2>/dev/null || cd; [ -f ~/.sbx-env ] && . ~/.sbx-env; $cmd"
}

nixos_rebuild() {
  local name=$1 upgrade=${2:-}
  incus exec "$name" --env "PATH=$GUEST_PATH" -- sh -euc "
    export http_proxy=$SBX_PROXY_URL https_proxy=$SBX_PROXY_URL
    ${upgrade:+nix-channel --update}
    nixos-rebuild switch"
}

# Write /etc/nixos/sbx-agents.nix with the nixpkgs of the given agents.
nixos_agents_file() {
  local name=$1 a p pkgs="" tmp; shift
  for a; do
    p=$(agent_var "$a" AGENT_NIXPKG)
    [[ -n $p ]] || die "agent '$a' has no AGENT_NIXPKG, cannot install it on NixOS"
    pkgs+=" $p"
  done
  tmp=$(mktemp)
  printf '# generated by sbx: coding agents of this sandbox\n{ pkgs, ... }:\n{\n  environment.systemPackages = with pkgs; [%s ];\n}\n' "$pkgs" > "$tmp"
  incus file push "$tmp" "$name/etc/nixos/sbx-agents.nix" --mode 0644
  rm -f "$tmp"
}

cmd_agent_install() {
  local name=$1 update="" a agents=(); shift
  for a; do
    if [[ $a == --update ]]; then update=1; else valid_agent "$a"; agents+=("$a"); fi
  done
  [[ ${#agents[@]} -gt 0 ]] || die "usage: sbx agent-install <name> <agent...> [--update]"
  wait_ready "$name"
  if [[ $(incus config get "$name" user.sbx.image) == nixos ]]; then
    info "NixOS: adding $(echo "${agents[@]}") to /etc/nixos/sbx-agents.nix and rebuilding"
    # shellcheck disable=SC2046
    nixos_agents_file "$name" $(printf '%s\n' $(get_list "$name" user.sbx.agents) "${agents[@]}" | sort -u)
    nixos_rebuild "$name" "$update"
    update=""   # binaries come from nixpkgs; install.sh only does per-user config there
  fi
  for a in "${agents[@]}"; do
    info "installing agent '$a' in $name${update:+ (update)}"
    incus file push "$SBX_ROOT/agents/$a/install.sh" "$name/tmp/sbx-install-$a.sh" --mode 0755
    as_user "$name" "cd && SBX_AGENT_UPDATE=$update bash /tmp/sbx-install-$a.sh" </dev/null \
      || die "installing agent '$a' failed (check 'sbx net log' for blocked domains)"
    list_add "$name" user.sbx.agents "$a"
  done
}

cmd_run() {
  local name=$1 agent=$2; shift 2
  valid_agent "$agent"
  [[ " $(get_list "$name" user.sbx.agents) " == *" $agent "* ]] \
    || die "agent '$agent' is not installed in $name (sbx agent-install $name $agent)"
  as_user "$name" "exec $(agent_var "$agent" AGENT_CMD) $(printf '%q ' "$@")"
}

# ---------------------------------------------------------------- secrets
secret_set() {
  local name=$1 key=$2 file=$3 value
  valid_key "$key"
  [[ -r $file ]] || die "cannot read $file"
  value=$(tr -d '\r' < "$file")
  value=${value%$'\n'}
  printf 'export %s=%q\n' "$key" "$value" | incus exec -T "$name" --env "PATH=$GUEST_PATH" -- \
    su -l "$GUSER" -c "umask 077; f=\$HOME/.sbx-env; touch \$f; { grep -v '^export $key=' \$f || true; cat; } > \$f.new && mv \$f.new \$f"
  list_add "$name" user.sbx.secrets "$key"
}
secret_rm() {
  local name=$1 key=$2
  valid_key "$key"
  incus exec -T "$name" --env "PATH=$GUEST_PATH" -- \
    su -l "$GUSER" -c "f=\$HOME/.sbx-env; [ -f \$f ] || exit 0; umask 077; grep -v '^export $key=' \$f > \$f.new || true; mv \$f.new \$f" </dev/null
  list_del "$name" user.sbx.secrets "$key"
}

cmd_secret() {
  local sub=${1:-}; shift || true
  need "${1:-}"
  case $sub in
    set) [[ $# -eq 3 ]] || die "usage: sbx secret set <name> KEY FILE"; secret_set "$@"; info "secret $2 set in $1" ;;
    rm)  [[ $# -eq 2 ]] || die "usage: sbx secret rm <name> KEY"; secret_rm "$@"; info "secret $2 removed from $1" ;;
    ls)  get_list "$1" user.sbx.secrets | tr ' ' '\n' | sed '/^$/d' ;;
    *) usage; exit 2 ;;
  esac
}

# ---------------------------------------------------------------- lifecycle
cmd_init() {
  local p tmp
  for p in base container vm nixos-base; do
    incus profile show "sbx-$p" >/dev/null 2>&1 || incus profile create "sbx-$p" >/dev/null
    tmp=$(mktemp); render "$SBX_ROOT/profiles/sbx-$p.yaml" > "$tmp"
    incus profile edit "sbx-$p" < "$tmp"; rm -f "$tmp"
  done
  info "profiles loaded: sbx-base sbx-container sbx-vm sbx-nixos-base"
}

provision_nixos() {
  local name=$1 tmp
  info "NixOS: pushing /etc/nixos/sbx.nix and rebuilding (first run downloads a lot)"
  tmp=$(mktemp); render "$SBX_ROOT/nixos/sbx.nix" > "$tmp"
  incus file push "$tmp" "$name/etc/nixos/sbx.nix" --mode 0644; rm -f "$tmp"
  nixos_agents_file "$name"   # empty for now; agents are added by cmd_agent_install
  incus exec "$name" --env "PATH=$GUEST_PATH" -- sh -euc "
    f=/etc/nixos/configuration.nix
    grep -q './sbx.nix' \$f || sed -i '0,/imports = \[/s//imports = [ .\/sbx.nix/' \$f
    grep -q './sbx.nix' \$f || { echo 'could not add import to configuration.nix' >&2; exit 1; }
    systemctl set-environment http_proxy=$SBX_PROXY_URL https_proxy=$SBX_PROXY_URL
    systemctl restart nix-daemon
    export http_proxy=$SBX_PROXY_URL https_proxy=$SBX_PROXY_URL
    nix-channel --list | grep -q . || nix-channel --add https://nixos.org/channels/nixos-unstable nixos
    nix-channel --update
    nixos-rebuild switch
    systemctl unset-environment http_proxy https_proxy
    mkdir -p /var/lib/sbx && date -Is > /var/lib/sbx/provisioned
  "
}

cmd_new() {
  local name="" path="" type=container image=ubuntu cpus="" mem="" disk="" agents=() secrets=() a s
  while [[ $# -gt 0 ]]; do
    case $1 in
      --path) path=$2; shift 2 ;;
      --vm) type=vm; shift ;;
      --container) type=container; shift ;;
      --image) image=$2; shift 2 ;;
      --agent) IFS=, read -ra a <<< "$2"; agents+=("${a[@]}"); shift 2 ;;
      --secret) secrets+=("$2"); shift 2 ;;
      --cpus) cpus=$2; shift 2 ;;
      --memory) mem=$2; shift 2 ;;
      --disk) disk=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [[ -z $name ]] || die "unexpected argument $1"; name=$1; shift ;;
    esac
  done
  [[ -n $name && -n $path ]] || { usage; exit 2; }
  valid_name "$name"
  exists "$name" && die "$name already exists"
  path=$(realpath -e "$path") || die "path does not exist"
  [[ -d $path ]] || die "$path is not a directory"
  case "$path" in /|"$HOME"|/home|/etc|/usr|/var|/root|/tmp) die "refusing to share $path; pass a project directory" ;; esac
  [[ ${#agents[@]} -gt 0 ]] || read -ra agents <<< "$SBX_DEFAULT_AGENTS"
  for a in "${agents[@]}"; do valid_agent "$a"; done
  for s in "${secrets[@]}"; do
    [[ $s == *=* ]] || die "--secret expects KEY=FILE"
    valid_key "${s%%=*}"; [[ -r ${s#*=} ]] || die "cannot read ${s#*=}"
  done

  cmd_init >/dev/null

  local img args=() profiles=()
  case $image in
    ubuntu) img=$SBX_UBUNTU_IMAGE; profiles=(-p sbx-base -p "sbx-$type") ;;
    nixos)  img=$SBX_NIXOS_IMAGE;  profiles=(-p sbx-nixos-base -p "sbx-$type")
            [[ $type == vm ]] && args+=(-c security.secureboot=false) ;;
    *) die "--image must be ubuntu or nixos" ;;
  esac
  [[ $type == vm ]] && args+=(--vm)
  [[ -n $cpus ]] && args+=(-c "limits.cpu=$cpus")
  [[ -n $mem  ]] && args+=(-c "limits.memory=$mem")
  [[ -n $disk ]] && args+=(-d "root,size=$disk")
  args+=(-c user.sbx=true -c "user.sbx.path=$path" -c "user.sbx.image=$image")

  info "creating $type '$name' from $img"
  incus init "$img" "$name" "${profiles[@]}" "${args[@]}"

  local dev=(source="$path" path=/work)
  [[ $type == container ]] && dev+=(shift=true)
  incus config device add "$name" work disk "${dev[@]}" >/dev/null
  info "sharing $path -> $name:/work (nothing else from the host)"

  incus start "$name"
  wait_ready "$name"

  if [[ $image == ubuntu ]]; then
    info "waiting for cloud-init provisioning (Docker, base tools) ..."
    local rc=0; incus exec "$name" -- cloud-init status --wait >/dev/null || rc=$?
    if ! incus exec "$name" -- test -f /var/lib/sbx/provisioned; then
      incus exec "$name" -- tail -n 40 /var/log/cloud-init-output.log >&2 || true
      die "provisioning failed (cloud-init rc=$rc). Inspect: sbx root $name; check 'sbx net log' for blocked domains"
    fi
  else
    provision_nixos "$name"
  fi

  for s in "${secrets[@]}"; do secret_set "$name" "${s%%=*}" "${s#*=}"; done
  [[ ${#secrets[@]} -eq 0 ]] || info "secrets set: $(for s in "${secrets[@]}"; do printf '%s ' "${s%%=*}"; done)"
  # one agent failing (e.g. blocked download) must not leave the sandbox without a clean snapshot
  local failed=()
  for a in "${agents[@]}"; do ( cmd_agent_install "$name" "$a" ) || failed+=("$a"); done

  incus snapshot create "$name" clean
  if [[ ${#failed[@]} -gt 0 ]]; then
    die "sandbox ready (snapshot 'clean' taken) but these agents failed to install: ${failed[*]}. Check 'sbx net log', then: sbx agent-install $name ${failed[*]}"
  fi
  info "ready. snapshot 'clean' taken. Try: sbx run $name ${agents[0]}"
}

cmd_net() {
  local sub=${1:-}; shift || true
  case $sub in
    open|close)
      need "${1:-}"; is_sbx "$1"
      local ip; ip=$(inst_ip "$1") || true
      [[ -n $ip ]] || die "$1 has no address on $SBX_BRIDGE (running?)"
      if [[ $sub == open ]]; then sudo /usr/local/sbin/sbx-net open "$ip" "${2:-$SBX_NET_OPEN_MINUTES}"
      else sudo /usr/local/sbin/sbx-net close "$ip"; fi ;;
    status) sudo /usr/local/sbin/sbx-net status ;;
    log)
      local n=${1:-5000} map
      map=$(for i in $(incus list user.sbx=true -c n -f csv 2>/dev/null); do echo "$(inst_ip "$i" || true) $i"; done)
      tail -n "$n" /var/log/sbx-proxy/access.log 2>/dev/null | awk '$4 ~ /DENIED/ {print $3, $7}' \
        | awk -v m="$map" 'BEGIN{n=split(m,l,"\n"); for(i=1;i<=n;i++){split(l[i],p," "); nm[p[1]]=p[2]}}
               {h=$2; sub(/^[a-z]+:\/\//,"",h); sub(/[\/:].*$/,"",h); print (($1 in nm)?nm[$1]:$1), h}' \
        | sort | uniq -c | sort -rn | head -50 ;;
    *) usage; exit 2 ;;
  esac
}

main() {
  local cmd=${1:-}; shift || true
  case $cmd in
    init) cmd_init ;;
    new) cmd_new "$@" ;;
    ls|list) incus list user.sbx=true -c ns4tSL -f table ;;
    start) need "${1:-}"; incus start "$1"; wait_ready "$1" ;;
    wait) need "${1:-}"; wait_ready "$1" ;;
    stop) need "${1:-}"; incus stop "$1" ;;
    rm|delete)
      need "${1:-}"; is_sbx "$1"
      if [[ ${2:-} != -f ]]; then
        read -r -p "Delete sandbox '$1' and all its snapshots? [y/N] " a; [[ $a == [yY]* ]] || exit 1
      fi
      local ip; ip=$(inst_ip "$1" || true)
      [[ -n $ip ]] && sudo -n /usr/local/sbin/sbx-net close "$ip" >/dev/null 2>&1 || true
      incus delete --force "$1" ;;
    agents)
      local a
      for a in $(list_agents); do printf '%-10s %s\n' "$a" "$(agent_var "$a" AGENT_DESC)"; done ;;
    agent-install) need "${1:-}"; cmd_agent_install "$@" ;;
    run)
      need "${1:-}"; [[ -n ${2:-} ]] || die "usage: sbx run <name> <agent> [args]"
      cmd_run "$@" ;;
    claude) need "${1:-}"; local n=$1; shift; cmd_run "$n" claude "$@" ;;
    shell) need "${1:-}"; as_user "$1" "exec bash -l" ;;
    root)  need "${1:-}"; incus exec "$1" --env "PATH=$GUEST_PATH" -- bash -l ;;
    exec)
      need "${1:-}"; local n=$1; shift; [[ ${1:-} == -- ]] && shift
      [[ $# -gt 0 ]] || die "usage: sbx exec <name> -- <cmd...>"
      as_user "$n" "$(printf '%q ' "$@")" ;;
    secret) cmd_secret "$@" ;;
    snap)  need "${1:-}"; incus snapshot create "$1" "${2:-$(date +%Y%m%d-%H%M%S)}" ;;
    snaps) need "${1:-}"; incus snapshot list "$1" ;;
    restore)
      need "${1:-}"; incus snapshot restore "$1" "${2:-clean}"
      [[ $(incus list "^$1\$" -c s -f csv) == RUNNING ]] && wait_ready "$1" || true ;;
    net) cmd_net "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command '$cmd' (sbx help)" ;;
  esac
}

main "$@"
