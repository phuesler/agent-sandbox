[Unit]
Description=Agent sandbox egress firewall (nftables table inet sbx)
After=network-online.target incus.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/sbx/egress.nft
ExecStart=-/usr/local/lib/sbx/docker-user.sh
ExecStop=-/usr/sbin/nft delete table inet sbx

[Install]
WantedBy=multi-user.target
